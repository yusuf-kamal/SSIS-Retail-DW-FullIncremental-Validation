      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;IF OBJECT_ID('&quot; + @[User::TargetSchema] + &quot;.&quot; + @[User::TargetTable] + &quot;') IS NOT NULL DROP TABLE &quot; + @[User::TargetSchema] + &quot;.&quot; + @[User::TargetTable] + &quot;; SELECT * INTO &quot; + @[User::TargetSchema] + &quot;.&quot; + @[User::TargetTable] + &quot; FROM &quot; + @[User::SourceDatabase] + &quot;.&quot; + @[User::SourceSchema] + &quot;.&quot; + @[User::SourceTable] + &quot;; SELECT COUNT(*) AS RowsInserted FROM &quot; + @[User::TargetSchema] + &quot;.&quot; + @[User::TargetTable] + &quot;;&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SQL_Insert">
      <DTS:VariableValue
        DTS:DataType="8">IF OBJECT_ID('.') IS NOT NULL DROP TABLE .; SELECT * INTO . FROM ContosoRetailDW..; SELECT COUNT(*) AS RowsInserted FROM .;</DTS:VariableValue>
