      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_WSTR,4)YEAR(@[User::PkgStartTime]) + &quot;-&quot; +&#xA;RIGHT(&quot;0&quot; + (DT_WSTR,2)MONTH(@[User::PkgStartTime]),2) + &quot;-&quot; +&#xA;RIGHT(&quot;0&quot; + (DT_WSTR,2)DAY(@[User::PkgStartTime]),2) + &quot; &quot; +&#xA;RIGHT(&quot;0&quot; + (DT_WSTR,2)DATEPART(&quot;hh&quot;,@[User::PkgStartTime]),2) + &quot;:&quot; +&#xA;RIGHT(&quot;0&quot; + (DT_WSTR,2)DATEPART(&quot;mi&quot;,@[User::PkgStartTime]),2) + &quot;:&quot; +&#xA;RIGHT(&quot;0&quot; + (DT_WSTR,2)DATEPART(&quot;ss&quot;,@[User::PkgStartTime]),2)"
      DTS:IncludeInDebugDump="2345"
